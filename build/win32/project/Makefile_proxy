# detect target architecture
!IF "$(CPU)" == ""
CPU=$(PROCESSOR_ARCHITECTURE)
!ENDIF

!IF "$(CPU)" == "AMD64"
TARGETDIR = ..\..\..\bin\win64
ADD_LFLAGS = /MACHINE:X64

!ELSE
!ERROR Unsupported CPU architecture: $(CPU) (the proxy is 64-bit only)
!ENDIF

PROJECTNAME = zabbix_proxy
PROJECTDIR = ..\..\..\src\$(PROJECTNAME)
TARGETNAME = zabbix_proxy
TARGETEXT = exe
PROGNAME = $(TARGETDIR)\$(TARGETNAME).$(TARGETEXT)

PDBS = $(TARGETDIR)\$(TARGETNAME).pdb $(TARGETNAME).$(TARGETEXT).pdb

# ..\include\proxy must precede ..\include\common so that the proxy build
# configuration wins over the agent one - both are named config.h.
ADD_INCS = /I ..\include\proxy

# The proxy links the "proxy" flavour of the sysinfo library, which automake
# builds with this metric set (see src/libs/zbxsysinfo/Makefile.am).
ADD_CFLAGS = $(ADD_CFLAGS) /D WITH_COMMON_METRICS /D WITH_HTTP_METRICS \
	/D WITH_SIMPLE_METRICS /D WITH_HOSTNAME_METRIC \
	/D ZABBIX_PROXY \
	/Zi \
	/D DEFAULT_CONFIG_FILE="\"C:\\zabbix_proxy.conf\"" \
	/D DEFAULT_EXTERNAL_SCRIPTS_PATH="\"C:\\zabbix\\externalscripts\"" \
	/D DEFAULT_LOAD_MODULE_PATH="\"C:\\zabbix\\modules\"" \
	/D DEFAULT_SSL_CERT_LOCATION="\"C:\\zabbix\\ssl\\certs\"" \
	/D DEFAULT_SSL_KEY_LOCATION="\"C:\\zabbix\\ssl\\keys\"" \
	/Fd$(TARGETNAME).$(TARGETEXT).pdb

ADD_LFLAGS = $(ADD_LFLAGS) /DEBUG /OPT:REF /DELAYLOAD:wevtapi.dll

ADD_RFLAGS = /d "ZABBIX_PROXY"

