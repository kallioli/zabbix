  Software Foundation, version 3.

  Installer for the Windows Zabbix proxy. Build it with WiX v5:

      wix build zabbix_proxy.wxs -ext WixToolset.Util.wixext ^
          -d Version=7.4.13 -d BinDir=..\..\..\bin\win64 -d ConfDir=..\..\..\conf ^
          -arch x64 -o zabbix_proxy-7.4.13-x64.msi

  Silent install, with the proxy configured in one go:

      msiexec /i zabbix_proxy-7.4.13-x64.msi /qn ^
          SERVER=zabbix.example.com HOSTNAME=proxy-paris
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Zabbix Proxy"
           Manufacturer="Zabbix SIA"
           Version="$(Version)"
           UpgradeCode="7f3a1c46-0b52-4f8e-9a71-2d6c9e4b8a10"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Zabbix Proxy is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ProxyIcon" SourceFile="$(BinDir)\zabbix_proxy.exe" />
    <Property Id="ARPPRODUCTICON" Value="ProxyIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.zabbix.com" />

    <!-- Answered at install time; see GenerateConfig below. -->
    <Property Id="SERVER" Value="127.0.0.1" />
    <Property Id="HOSTNAME" />
    <Property Id="LISTENPORT" Value="10051" />

    <Launch Condition="VersionNT64" Message="The Zabbix proxy is 64-bit and needs a 64-bit edition of Windows." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Zabbix Proxy" />
    </StandardDirectory>

    <Feature Id="Main" Title="Zabbix Proxy" Level="1">
      <ComponentGroupRef Id="ProxyFiles" />
      <ComponentRef Id="ProxyService" />
      <ComponentRef Id="DataFolders" />
    </Feature>

    <SetProperty Id="HOSTNAME" Value="[ComputerName]" Before="CostFinalize"
                 Sequence="both" Condition="NOT HOSTNAME" />

    <!--
      The configuration is written once, at first install, from the properties
      above. Upgrades find the file present and leave it untouched, so local
      edits survive. Everything else stays in the sample next to it.
    -->
    <SetProperty Id="GenerateConfig"
                 Before="GenerateConfig"
                 Sequence="execute"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$p='[INSTALLFOLDER]zabbix_proxy.conf'; if (-not (Test-Path -LiteralPath $p)) { @('# Written by the Zabbix Proxy installer. Edit freely: upgrades keep this file.','# The full list of options is in zabbix_proxy.conf.example next to it.','','ProxyMode=0','Server=[SERVER]','Hostname=[HOSTNAME]','ListenPort=[LISTENPORT]','DBName=[DataFolder]zabbix_proxy.db','SocketDir=[DataFolder]','LogType=file','LogFile=[DataFolder]zabbix_proxy.log','LogFileSize=10') | Set-Content -LiteralPath $p -Encoding ASCII }&quot;" />

    <CustomAction Id="GenerateConfig"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <InstallExecuteSequence>
      <!-- After the files are laid down, before the service is started. -->
      <Custom Action="GenerateConfig" After="InstallFiles" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <!--
      The agent's installer asks for these, and an operator expects the same
      here. Without the dialog a double-click produces a proxy pointed at
      127.0.0.1 under the computer's name, which is almost never right and
      leaves the file to edit inside Program Files.

      HOSTNAME is filled in by the SetProperty above, which runs before
      CostFinalize and therefore before this dialog, so the field opens on the
      computer name rather than empty.
    -->
    <UI>
      <Dialog Id="ProxyConfigDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Proxy configuration" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="These are written to zabbix_proxy.conf and can be changed there later." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="ServerLabel" Type="Text" X="20" Y="62" Width="320" Height="12"
                 NoPrefix="yes" Text="&amp;Zabbix server, as host or host:port" />
        <Control Id="ServerEdit" Type="Edit" X="20" Y="75" Width="320" Height="18"
                 Property="SERVER" Indirect="no" />

        <Control Id="HostnameLabel" Type="Text" X="20" Y="103" Width="320" Height="12"
                 NoPrefix="yes" Text="Proxy &amp;name, exactly as declared on the server" />
        <Control Id="HostnameEdit" Type="Edit" X="20" Y="116" Width="320" Height="18"
                 Property="HOSTNAME" Indirect="no" />

        <Control Id="PortLabel" Type="Text" X="20" Y="144" Width="320" Height="12"
                 NoPrefix="yes" Text="&amp;Port this proxy listens on" />
        <Control Id="PortEdit" Type="Edit" X="20" Y="157" Width="80" Height="18"
                 Property="LISTENPORT" Indirect="no" />
        <Control Id="PortNote" Type="Text" X="106" Y="160" Width="234" Height="24"
                 NoPrefix="yes"
                 Text="An active proxy listens too, for the trapper and active agents." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Slot it between the install directory and the confirmation page. The
           higher Order wins over the dialog set's own Next, which goes straight
           to VerifyReadyDlg. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog"
               Value="ProxyConfigDlg" Order="3"
               Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="ProxyConfigDlg" Control="Back" Event="NewDialog"
               Value="InstallDirDlg" />
      <Publish Dialog="ProxyConfigDlg" Control="Next" Event="NewDialog"
               Value="VerifyReadyDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="ProxyConfigDlg" Order="3" Condition="NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <ComponentGroup Id="ProxyFiles" Directory="INSTALLFOLDER">
      <Component Id="ProxyExe" Guid="1c2f5a90-84d7-4e63-9b2a-5f0e7c318d24">
        <File Id="zabbix_proxy.exe" Source="$(BinDir)\zabbix_proxy.exe" KeyPath="yes" />
      </Component>

      <!-- The documented sample. It is reference material, so an upgrade
           refreshes it; the live configuration next to it is left alone. -->
      <Component Id="ProxyConfSample" Guid="4e91b7d3-2a08-4c15-8f6b-91d0c4a7e532">
        <File Id="zabbix_proxy.conf.example" Name="zabbix_proxy.conf.example"
              Source="$(ConfDir)\zabbix_proxy.win.conf" KeyPath="yes" />
      </Component>

      <!-- The operator's guide, beside the thing it describes. Renamed so it
           opens in Notepad rather than prompting for an application. -->
      <Component Id="ProxyOperatingGuide" Guid="8a5d0c72-4f19-4b6e-a3c8-71e59d2b04f6">
        <File Id="OPERATING.txt" Name="OPERATING.txt"
              Source="..\OPERATING_proxy" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- The log and the SQLite buffer live under ProgramData rather than in
         Program Files, which a service account should not be writing to. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataFolder" Name="Zabbix Proxy" />
    </StandardDirectory>

    <Component Id="DataFolders" Directory="DataFolder"
               Guid="9d4c1e68-7b35-4a02-83f1-6c5e2b90af47">
      <CreateFolder />
      <RegistryValue Root="HKLM" Key="Software\Zabbix\Zabbix Proxy" Name="DataPath"
                     Type="string" Value="[DataFolder]" KeyPath="yes" />
      <RemoveFolder Id="RemoveDataFolder" On="uninstall" />
    </Component>

    <Component Id="ProxyService" Directory="INSTALLFOLDER"
               Guid="b6021f4a-3c8d-4719-a05e-8f7d264c1b93">
      <RegistryValue Root="HKLM" Key="Software\Zabbix\Zabbix Proxy" Name="Installed"
                     Type="integer" Value="1" KeyPath="yes" />

      <ServiceInstall Id="ProxyServiceInstall"
                      Name="Zabbix Proxy"
                      DisplayName="Zabbix Proxy"
                      Description="Collects monitoring data and forwards it to a Zabbix server."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="NT AUTHORITY\LocalService"
                      Arguments="-c &quot;[INSTALLFOLDER]zabbix_proxy.conf&quot;"
                      Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="none"
                            RestartServiceDelayInSeconds="60" />
      </ServiceInstall>

      <ServiceControl Id="ProxyServiceControl"
                      Name="Zabbix Proxy"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>
  </Fragment>

</Wix>
